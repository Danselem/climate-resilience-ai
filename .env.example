# Runtime configuration. Names only — never commit values.
# Copy to .env and fill in locally.

CRP_DATA_DIR=data
CRP_DATABASE_URL=sqlite:///data/mart.db
CRP_MUNICIPALITY=ethekwini

CRP_HISTORY_START=1980-01-01
# Unset = the last complete calendar year, resolved at fetch time (ADR-008).
# Set explicitly to pin a window; partial years are withheld, never mislabelled.
# CRP_HISTORY_END=2025-12-31
CRP_ERA5_CELL_DEG=0.25
CRP_MIN_COVERAGE=0.90
CRP_EXPECTED_WARD_COUNT=110

CRP_LOG_LEVEL=INFO

# Not yet used by any code path. Declared so the shape is agreed before
# the assistant exists. Never commit real values.
OPENROUTER_API_KEY=
LLM_MODEL_INTENT=
LLM_MODEL_SYNTHESIS=

# Copernicus CDS credentials for the production ERA5 path (ingestion/cds_era5.py).
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
