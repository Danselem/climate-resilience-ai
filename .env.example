# Runtime configuration. Names only — never commit values.
# Copy to .env and fill in locally.

CRP_DATA_DIR=data
CRP_DATABASE_URL=sqlite:///data/mart.db
CRP_MUNICIPALITY=ethekwini

CRP_HISTORY_START=1980-01-01
# Unset = the last complete calendar year, resolved at fetch time (ADR-008).
# Set explicitly to pin a window; partial years are withheld, never mislabelled.
# CRP_HISTORY_END=2025-12-31
CRP_ERA5_CELL_DEG=0.25
CRP_MIN_COVERAGE=0.90
CRP_EXPECTED_WARD_COUNT=110

CRP_LOG_LEVEL=INFO

# Optional API key. Unset = local use. Set = every endpoint except /health
# requires `X-API-Key`. In AWS this comes from Secrets Manager.
# CRP_API_KEY=

# Document index (pgvector). Separate from the mart on purpose.
CRP_DOCUMENTS_DSN=postgresql://crp:crp@localhost:5433/crp
CRP_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Assistant models, tried in order until one answers. A free endpoint first;
# a cheap paid one second, because free capacity rate-limits without notice.
# Both are OpenRouter ids; the `openrouter:` prefix is added automatically.
LLM_MODELS=amazon/nova-micro-v1,particle-ai/particle-1:free

# Never commit real values.
OPENROUTER_API_KEY=

# Copernicus CDS credentials for the production ERA5 path (ingestion/cds_era5.py).
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
